# 构建输出
dist/
bin/
obj/
# objRelFiles 是中间产物重定向目录（自包含/重链接那遍的产出）。SDK 的默认源码
# glob **/*.cs 只排除 obj/ 与 bin/，不排除它；一旦残留，里面生成的
# *.AssemblyInfo.cs 会被当成普通源码编进去，与新生成的特性文件撞车 → CS0579。
objRelFiles/

# 谷歌官方 platform-tools 二进制（构建前按 README 自行下载）
tools/adb/

# scrcpy：源压缩包不入库（解压目录为构建必需，随仓库分发）
tools/scrcpy/*.zip

# 仓库恢复时的损坏备份
.git-broken/

# 下载缓存与 SDK 安装器
tools/dl/
tools/sdk/

# 工作区私有数据
.workbuddy/

# 临时文件与诊断日志
*.log
*.user
*.suo
